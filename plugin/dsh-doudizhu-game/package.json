{
  "name": "dsh-doudizhu-game",
  "version": "0.1.0",
  "description": "斗地主：在 DSH 里人机对战，三家分别选七档难度，带记牌器、出牌建议、叫抢/加倍/明牌、完整结算与复盘。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "doudizhu",
    "斗地主",
    "card-game"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "lib",
    "src",
    "assets",
    "test",
    "client.js",
    "build.mjs",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node test/game.test.mjs && node test/render.test.mjs && node test/check-keys.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}
